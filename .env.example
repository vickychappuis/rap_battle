# --- API keys (required) ---
# Without these the API still starts and /health answers, but battles fail.
OPENAI_API_KEY=sk-your-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# --- Models (optional) ---
# Lyricist model. Defaults to gpt-5-mini; the reasoning settings assume a
# gpt-5-family reasoning model. Note these models ignore `temperature`.
OPENAI_MODEL=gpt-5-mini
OPENAI_STT_MODEL=whisper-1
# The judge is a plain chat-completions call, so it is configured separately
# from the lyricist above.
OPENAI_JUDGE_MODEL=gpt-4o-mini

# --- Battle format (optional) ---
# One turn is BARS_PER_TURN bars at the base track's tempo; at 90bpm, 16 bars
# is ~43s. That figure sets both the user's recording window and the generated
# verse length. There is no BPM setting: the tempo comes from the track's
# filename (assets/tracks/*_<bpm>bpm.mp3), so audio and tempo cannot diverge.
BARS_PER_TURN=16
TURNS_PER_PLAYER=2

# --- Limits (optional) ---
# Max size of a single uploaded recording, in MB. Larger uploads get HTTP 413.
MAX_UPLOAD_MB=8
# How long an idle session is kept in memory before it is reclaimed. Sessions
# live in-process, so this is also how long a battle can be left paused.
SESSION_TTL_SECONDS=3600
# How long generated mp3s stay on disk. Defaults to SESSION_TTL_SECONDS.
# GENERATED_AUDIO_TTL_SECONDS=3600

# --- CORS (optional) ---
# Comma-separated extra origins allowed to call the API, in addition to the
# localhost dev servers that are always allowed.
# ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Logging (optional) ---
# Log full transcriptions, lyrics and TTS prompts. Off by default because they
# contain the user's raw speech.
DEBUG_LOG_CONTENT=false

# --- Test mode (optional) ---
# Skip the ElevenLabs call and reuse an existing mp3 as the AI response.
# MOCK_ELEVENLABS=true requires MOCK_RESPONSE_PATH to point at a real file;
# the pipeline errors out rather than silently falling back to the billed API.
MOCK_ELEVENLABS=false
# MOCK_RESPONSE_PATH=path/to/some_response.mp3
